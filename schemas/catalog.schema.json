{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-collection.local/schemas/catalog.schema.json",
  "title": "Agent Skill Collection Generated Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "collection_revision", "skills"],
  "properties": {
    "version": { "const": 1 },
    "collection_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "path", "content_hash"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "name": { "$ref": "#/$defs/name" },
        "source": { "$ref": "#/$defs/name" },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
